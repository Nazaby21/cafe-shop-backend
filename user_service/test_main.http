### Coffee Shop - Auth (user) Service manual test requests
### Run `uvicorn app.main:app --reload --port 8001` from user_service/ first.

@baseUrl = http://127.0.0.1:8001

### Register a new customer
POST {{baseUrl}}/user
Content-Type: application/json

{
  "username": "alice",
  "email": "alice@example.com",
  "password": "supersecret1"
}

###

### Login
# copy the "access_token" from the response into @token below
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "supersecret1"
}

###

@token = REPLACE_WITH_ACCESS_TOKEN

### Get my own profile
GET {{baseUrl}}/user/me
Authorization: Bearer {{token}}

###

### List all users (requires admin/staff role - will 403 for a plain customer)
GET {{baseUrl}}/user?page=1&page_size=20
Authorization: Bearer {{token}}

###

### Get a specific user (self or admin/staff)
GET {{baseUrl}}/user/1
Authorization: Bearer {{token}}

###

### Update my own profile
PUT {{baseUrl}}/user/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "alice-updated",
  "email": "alice@example.com",
  "is_active": true
}

###

### Change my own password
PATCH {{baseUrl}}/user/1/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "old_password": "supersecret1",
  "new_password": "evenmoresecret2"
}

###

### Wrong password login -> 401 InvalidCredentials
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "wrong-password"
}

###

### No token -> 401 Unauthorized
GET {{baseUrl}}/user/me
