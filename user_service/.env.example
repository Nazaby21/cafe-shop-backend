ENVIRONMENT=local

# Database Connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT settings - this JWT_SECRET_KEY must be copied verbatim into
# operation_service/.env and report_service/.env so tokens issued here
# can be verified by the other microservices.
# In production, this must be a secure random secret of at least 32 characters.
JWT_SECRET_KEY=dev-only-shared-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
