ENVIRONMENT=local

# Database Connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operation_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Must be IDENTICAL to user_service's JWT_SECRET_KEY / JWT_ALGORITHM, since
# operation_service verifies tokens issued by user_service rather than
# issuing its own.
# In production, this must be a secure random secret of at least 32 characters.
JWT_SECRET_KEY=dev-only-shared-secret-change-me
JWT_ALGORITHM=HS256

CORS_ORIGINS=*
