# Database Connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operation_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Must be IDENTICAL to user_service's JWT_SECRET_KEY / JWT_ALGORITHM, since
# operation_service verifies tokens issued by user_service rather than
# issuing its own.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

CORS_ORIGINS=*
