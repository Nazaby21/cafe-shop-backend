# =============================================================================
# COFFEE SHOP APIM PLATFORM - LOCAL DOCKER CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env before starting the stack.
# Local development uses throwaway values; never commit actual production secrets.

# Application Environment (local | dev | staging | production)
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Host 'postgres' is the internal Docker Compose service name
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_local_password
POSTGRES_DB=postgres
# Local loopback port published to Windows host (default: 5432; set to 5433 if host postgres service is running)
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# JWT Authentication Secret (MUST be identical across all microservices)
# -----------------------------------------------------------------------------
# Minimum 32 characters. Can be generated by: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_insecure_throwaway_jwt_secret_key_32bytes_minimum!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Gateway & Frontend Base URLs
# -----------------------------------------------------------------------------
# Public Kong Gateway proxy URL called by client browser on the host:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Internal Kong URL called by Next.js SSR / Server-side code inside Docker:
INTERNAL_API_BASE_URL=http://kong:8000

# -----------------------------------------------------------------------------
# Bakong KHQR Payment Gateway (STRICTLY MOCKED FOR LOCAL STUDY)
# -----------------------------------------------------------------------------
# Modes: mock | sandbox. Keep 'mock' for local development. Never call real NBC API.
BAKONG_MODE=mock
BAKONG_ACCOUNT_ID=coffee_shop@bakong
BAKONG_MERCHANT_NAME=Coffee Shop
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_STORE_LABEL=CoffeeShop-Main
BAKONG_TERMINAL_LABEL=POS-01
BAKONG_TOKEN=mock_dev_token
BAKONG_REGISTERED_EMAIL=merchant@coffeeshop.kh

# -----------------------------------------------------------------------------
# Developer Experience & File Watching (Windows / WSL2 Polling)
# -----------------------------------------------------------------------------
# Fixes unreliable inotify filesystem event propagation over Windows volume mounts
WATCHFILES_FORCE_POLLING=true
WATCHPACK_POLLING=true

# Allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
