# =============================================================================
# COFFEE SHOP APIM PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and replace placeholders with strong random values.
# NEVER commit real credentials or secrets to version control.

# Application Environment (local | dev | staging | production)
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL Only)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<set-strong-password-here>

# -----------------------------------------------------------------------------
# JWT Authentication Secret (MUST be shared across all microservices)
# Minimum 32 characters in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=<set-32-char-random-jwt-secret>

# -----------------------------------------------------------------------------
# Gateway & Public Base URL
# -----------------------------------------------------------------------------
# Public Kong Gateway proxy URL used by browser/frontend client:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Bakong KHQR Payment Gateway (Mock Mode Default)
# Modes: mock | sandbox
# -----------------------------------------------------------------------------
BAKONG_MODE=mock
BAKONG_ACCOUNT_ID=merchant@bakong
BAKONG_MERCHANT_NAME=Coffee Shop
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_STORE_LABEL=CoffeeShop-Main
BAKONG_TERMINAL_LABEL=POS-01
BAKONG_TOKEN=<set-bakong-open-api-jwt-token>
BAKONG_REGISTERED_EMAIL=merchant@coffeeshop.kh
