# report_service owns its own database (report_service_db). It is populated
# by syncing from user_service / operation_service over HTTP - see
# USER_SERVICE_BASE_URL / OPERATION_SERVICE_BASE_URL below - not by
# connecting to their databases directly.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=report_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

USER_SERVICE_BASE_URL=http://127.0.0.1:8001
OPERATION_SERVICE_BASE_URL=http://127.0.0.1:8002

# Must be IDENTICAL to user_service's JWT_SECRET_KEY / JWT_ALGORITHM. Used
# both to verify incoming client tokens on /report/* and to mint the
# internal service-account token used for the sync job's outbound calls.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
SERVICE_TOKEN_EXPIRE_MINUTES=5

SYNC_ON_STARTUP=true
SYNC_PAGE_SIZE=100

CORS_ORIGINS=*
