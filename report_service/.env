DB_HOST=localhost
DB_PORT=5432
DB_NAME=report_service_db
DB_USER=postgres
DB_PASSWORD=123

# Used only by the sync job to pull data from the other two services over HTTP.
USER_SERVICE_BASE_URL=http://127.0.0.1:8001
OPERATION_SERVICE_BASE_URL=http://127.0.0.1:8002

# Must be IDENTICAL to user_service/app/.env's JWT_SECRET_KEY / JWT_ALGORITHM
JWT_SECRET_KEY=dev-only-shared-secret-change-me
JWT_ALGORITHM=HS256
SERVICE_TOKEN_EXPIRE_MINUTES=5

SYNC_ON_STARTUP=true
SYNC_PAGE_SIZE=100

CORS_ORIGINS=*
